{
  "name": "af-helper",
  "productName": "AF Helper",
  "version": "0.2.0",
  "description": "Advanced Facade desktop helper: Leona lives on the desktop; click her to chat with the AF Hub assistant.",
  "main": "main.js",
  "private": true,
  "author": "Advanced Facade",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.advfacade.afhelper",
    "productName": "AF Helper",
    "files": ["main.js", "pet.html", "pet.js", "pet-preload.js", "assets/**", "panel-preload.js", "offline.html", "offline.js", "icon.png", "tray.png"],
    "directories": { "output": "dist" },
    "publish": [{ "provider": "generic", "url": "https://github.com/Oncaym/AF-hub/releases/latest/download" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "AF Helper",
      "artifactName": "AF-Helper-Setup-${version}.exe"
    }
  }
}
