{
  "rules": {
    ".read": false,
    ".write": false,

    // 项目摘要:任何登录用户可读(老板屏);写入只允许该项目自己的 summary 节点。
    // tracker 用匿名登录推数,所以这里不按 uid 限制,而是靠字段校验 + 只能写 summary。
    // 摘要里没有任何敏感数据(四个数字 + 名称),这个信任模型对内部够用。
    "projects": {
      ".read": "auth != null",
      "$projectId": {
        "summary": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name','done','total','ts'])",
          "done":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "total": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "ts":    { ".validate": "newData.isNumber()" },
          "$other": { ".validate": true }
        }
      }
    },

    // 第 2 步用:损坏台账。建在 Hub 里,各 tracker 不用改自己的界面。
    // 创建:任何登录用户(工头报损坏)。改 co 状态:只有 admins(老板/PM)。
    "damage": {
      ".read": "auth != null",
      "$projectId": {
        "$damageId": {
          ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['type','by','ts'])"
        }
      }
    },

    "admins": { ".read": "auth != null", ".write": false }
  }
}
