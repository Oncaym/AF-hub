{
  "rules": {
    ".read": false,
    ".write": false,

    // Project summaries.
    // READ  — real accounts only. Trackers sign in anonymously to push, so an
    //         anonymous session must not be able to read the whole portfolio.
    // WRITE — any signed-in client, but only the summary node, and only if the
    //         payload validates. A summary is four numbers and a name; there is
    //         nothing sensitive in it, which is what makes this trade acceptable.
    "projects": {
      // 2026-10: the af-hub login now also opens project trackers for foremen and
      // GCs (personal / other-company emails). The portfolio is staff-only: a
      // VERIFIED @advfacade.com address. Admins (by uid) keep access regardless.
      ".read": "(auth != null && auth.token.email_verified == true && auth.token.email.matches(/@advfacade\\.com$/i)) || (auth != null && root.child('admins').child(auth.uid).exists())",
      "$projectId": {
        "summary": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name','done','total','ts'])",
          "name":         { ".validate": "newData.isString() && newData.val().length <= 80" },
          "unit":         { ".validate": "newData.isString() && newData.val().length <= 24" },
          "scope":        { ".validate": "newData.isString() && newData.val().length <= 200" },
          "url":          { ".validate": "newData.isString() && newData.val().length <= 200" },
          "done":         { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "total":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "weekRate":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "prevWeekRate": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "avg4w":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "openDamage":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "pendingCO":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "ts":           { ".validate": "newData.isNumber()" },

          // The project's percentage. Each scope is measured in its own unit and the
          // scopes are averaged weighted by row count, so this is NOT done/total.
          "pct":          { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },

          // Per-scope split: unit class x sub-scope, e.g. "Storefront · exterior — Glass".
          // An array arrives in RTDB as an object keyed "0","1",… so $i matches the index.
          // NOTE the trap this whole block exists for: `$other: false` below rejects ANY
          // field that is not named here, and a rejected field fails the ENTIRE set().
          // Add a field to hub-report.js and you must add it here, or every tracker
          // silently stops reporting — which is exactly what happened on 2026-09-17.
          "breakdown": {
            "$i": {
              ".validate": "newData.hasChildren(['scope'])",
              "scope":    { ".validate": "newData.isString() && newData.val().length <= 80" },
              "done":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "total":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "qtyDone":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "qtyTotal": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "unit":     { ".validate": "newData.isString() && newData.val().length <= 24" },
              "$other":   { ".validate": false }
            }
          },

          "$other":       { ".validate": false }
        }
      }
    },

    // Step 2 — damage ledger. Kept on the hub so no tracker has to change its UI.
    // Staff (verified @advfacade.com) can file one; only admins can edit an
    // existing record, which is what makes the change-order decision auditable.
    "damage": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@advfacade\\.com$/i)",
      "$projectId": {
        "$damageId": {
          ".write": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@advfacade\\.com$/i) && (!data.exists() || root.child('admins').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['type','by','ts'])"
        }
      }
    },

    // 🚚 To send — projects WITHOUT a dashboard yet (core/tosend.js, /send/ Shop page).
    // Projects with a dashboard keep their requests in their own database (/toSend there).
    // Staff (verified @advfacade.com) add projects and requests; a request is changed or removed
    // only by whoever added it, or an admin. Only the shop (custom claim shop = true) marks it
    // sent or undoes that (Leo 10-19); the shop also reads the list. A project is never
    // deleted from the page, only marked done (hidden); admins can delete.
    "sendSites": {
      ".read": "(auth != null && auth.token.email_verified == true && auth.token.email.matches(/@advfacade\\.com$/i)) || (auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && auth.token.email_verified == true && auth.token.shop == true)",
      "$site": {
        ".write": "((auth != null && auth.token.email_verified == true && auth.token.email.matches(/@advfacade\\.com$/i)) || (auth != null && root.child('admins').child(auth.uid).exists())) && (newData.exists() || (auth != null && root.child('admins').child(auth.uid).exists()))",
        ".validate": "$site.matches(/^s_[a-z0-9_]+$/) && $site.length <= 40 && newData.hasChildren(['name', 'by', 'at'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "by": { ".validate": "newData.isString()" },
        "at": { ".validate": "newData.isNumber()" },
        "done": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "toSend": {
      ".read": "(auth != null && auth.token.email_verified == true && auth.token.email.matches(/@advfacade\\.com$/i)) || (auth != null && root.child('admins').child(auth.uid).exists()) || (auth != null && auth.token.email_verified == true && auth.token.shop == true)",
      "$site": {
        "$id": {
          ".write": "((auth != null && auth.token.email_verified == true && auth.token.email.matches(/@advfacade\\.com$/i)) || (auth != null && root.child('admins').child(auth.uid).exists())) && (!data.exists() || data.child('by').val() == auth.token.email || (auth != null && root.child('admins').child(auth.uid).exists()))",
          ".validate": "newData.hasChildren(['what', 'by', 'at', '_project']) && newData.child('_project').val() == $site && root.child('sendSites').child($site).exists() && (data.exists() || newData.child('by').val() == auth.token.email) && (auth.token.shop == true || (auth != null && root.child('admins').child(auth.uid).exists()) || data.child('sent').exists() == newData.child('sent').exists())",
          "what": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "by": { ".validate": "newData.isString()" },
          "at": { ".validate": "newData.isNumber()" },
          "_project": { ".validate": "newData.isString()" },
          "qty": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 99999" },
          "need": { ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "photo": { ".validate": "newData.isString() && newData.val().length <= 1500 && (newData.val().beginsWith('https://') || newData.val().beginsWith('http://'))" },
          "sent": {
            ".write": "(auth != null && auth.token.email_verified == true && auth.token.shop == true) || (auth != null && root.child('admins').child(auth.uid).exists())",
            ".validate": "newData.hasChildren(['by', 'at']) && newData.child('by').val() == auth.token.email",
            "by": { ".validate": "newData.isString()" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "admins": {
      ".read": "auth != null && auth.token.email_verified == true && auth.token.email.matches(/@advfacade\\.com$/i)",
      ".write": false
    }
  }
}
