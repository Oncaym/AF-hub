{
  "rules": {
    ".read": false,
    ".write": false,

    // Project summaries.
    // READ  — real accounts only. Trackers sign in anonymously to push, so an
    //         anonymous session must not be able to read the whole portfolio.
    // WRITE — any signed-in client, but only the summary node, and only if the
    //         payload validates. A summary is four numbers and a name; there is
    //         nothing sensitive in it, which is what makes this trade acceptable.
    "projects": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
      "$projectId": {
        "summary": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name','done','total','ts'])",
          "name":         { ".validate": "newData.isString() && newData.val().length <= 80" },
          "unit":         { ".validate": "newData.isString() && newData.val().length <= 24" },
          "scope":        { ".validate": "newData.isString() && newData.val().length <= 200" },
          "done":         { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "total":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "weekRate":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "prevWeekRate": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "avg4w":        { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "openDamage":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "pendingCO":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "ts":           { ".validate": "newData.isNumber()" },
          "$other":       { ".validate": false }
        }
      }
    },

    // Step 2 — damage ledger. Kept on the hub so no tracker has to change its UI.
    // Anyone signed in with a real account can file one; only admins can edit an
    // existing record, which is what makes the change-order decision auditable.
    "damage": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
      "$projectId": {
        "$damageId": {
          ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && (!data.exists() || root.child('admins').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['type','by','ts'])"
        }
      }
    },

    "admins": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
      ".write": false
    }
  }
}
