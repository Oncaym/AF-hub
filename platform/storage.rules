rules_version = '2';

// AF Hub — Cloud Storage rules for the shared bucket af-hub-8f188.firebasestorage.app.
// Paste into Firebase console → Storage → Rules → Publish.
//
// Every project keeps its files under p/<project id>/ (photos, warehouse,
// migrated legacy files), so two projects never write to the same name.
// Storage rules cannot read the Realtime Database, so they cannot check
// project membership: they let any signed-in account with a VERIFIED email
// add or remove files. The tracker only ever shows a file through a link
// stored in that project's database, which only its members can read.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    match /p/{project}/{rest=**} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if signedIn();
    }

    // Fab drawings (core/fab.js): whole PDF sets can be bigger than a photo, so
    // PDFs up to 100 MB here. Page images use the rule above. Read is the same as
    // every other project file: the link lives in /fab, which the GC cannot read.
    match /p/{project}/fab/{id}/{file} {
      allow create, update: if signedIn()
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Anything else in the bucket: closed.
    match /{everything=**} {
      allow read, write: if false;
    }
  }
}
