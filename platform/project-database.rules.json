{
  // ======================================================================
  //  AF Hub - rules for ONE PROJECT DATABASE (af-hub-8f188-<project>).
  //  The same file goes on every project database; nothing in it names a
  //  project. Which project a database belongs to is written once, by the
  //  migration / new-project workflow, at /meta/project, and only the Admin
  //  SDK can write /meta.
  //
  //  Who is who (the email key is the email with every '.' turned into ','):
  //    signed in   = a real account with a VERIFIED email. Anonymous sessions
  //                  (the hub summary writer) and unverified accounts get nothing.
  //    editor      = on /allowlist                   -> can change this project
  //    gc          = on /gcList                      -> reads; can post to /gcItems
  //    viewer      = on /viewers                     -> reads only
  //    staff       = verified @advfacade.com address -> reads EVERY project
  //    anyone else -> nothing, not even the project's name.
  //
  //  Why /state checks _project: a tracker page stamps its own project id on
  //  every save. If a page is ever pointed at the wrong database (a copied
  //  firebase-config.js), the ids differ and the save is refused here, by
  //  the server, before anything is overwritten.
  //
  //  Tests: platform/tests/rules.local.test.cjs (fast, local) and
  //  platform/tests/rules.emulator.test.mjs (the real emulator, in CI).
  // ======================================================================
  "rules": {
    ".read": false,
    ".write": false,

    // Which project this database is. Written by the Admin SDK only.
    "meta": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('gcList').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists())",
      ".write": false
    },

    // The whole tracker state, saved in one piece by the page (last write wins).
    "state": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('gcList').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists())",
      // newData.exists(): no page can wipe the project. Clearing it is a console job.
      ".write": "auth != null && auth.token.email_verified == true && newData.exists() && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
      ".validate": "newData.hasChildren(['_clientId', '_ts', '_by', '_project']) && root.child('meta/project').isString() && newData.child('_project').val() == root.child('meta/project').val() && newData.child('_by').val() == auth.token.email"
    },

    // Edit history - append only, each row signed by its author.
    "history": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('gcList').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists())",
      "$pushId": {
        ".write": "auth != null && auth.token.email_verified == true && !data.exists() && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
        ".validate": "newData.hasChildren(['ts', 'user', 'desc']) && newData.child('user').val() == auth.token.email"
      }
    },

    // Who's online - editors write only their own row.
    "presence": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('gcList').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists())",
      "$uid": {
        ".write": "auth != null && auth.token.email_verified == true && auth.uid == $uid && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
        ".validate": "newData.hasChildren(['email', 'since']) && newData.child('email').val() == auth.token.email"
      }
    },

    // Who opened the tracker - anyone with access adds their own row; only editors read.
    "access": {
      ".read": "auth != null && auth.token.email_verified == true && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
      "$id": {
        ".write": "auth != null && auth.token.email_verified == true && !data.exists() && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('gcList').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists())",
        ".validate": "newData.hasChildren(['email', 'ts']) && newData.child('email').val() == auth.token.email"
      }
    },

    // GC inbox (F-037): anyone with access posts their own item; editors triage.
    "gcItems": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('gcList').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists())",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "auth != null && auth.token.email_verified == true && (root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || (!data.exists() && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('gcList').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists())))",
        ".validate": "newData.hasChildren(['by', 'ts', 'text']) && (data.exists() || newData.child('by').val() == auth.token.email)"
      }
    },

    // Elevation geometry + takeoff cut list per unit, written by the takeoff tool's "-> Tracker"
    // and the tracker's own DXF import. Key = the unit id with '.' turned into ','. Every row is
    // stamped with this project's id and its author, like /state.
    "elevGeo": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('gcList').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists())",
      "$mark": {
        ".write": "auth != null && auth.token.email_verified == true && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
        ".validate": "newData.hasChildren(['_project', '_by', '_ts']) && root.child('meta/project').isString() && newData.child('_project').val() == root.child('meta/project').val() && newData.child('_by').val() == auth.token.email"
      }
    },

    // Fab drawings (core/fab.js): one row per uploaded PDF, links to the files in
    // p/<project>/fab/. Editors upload; editors, viewers and staff read. NOT the GC
    // (Leo, 2026-10-16): these are our shop's sheets, not a submittal.
    "fab": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists())",
      ".indexOn": ["uploadedAt"],
      "$id": {
        ".write": "auth != null && auth.token.email_verified == true && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
        ".validate": "newData.hasChildren(['name', 'pdf', 'pages', 'uploadedAt', '_by', '_project']) && newData.child('name').isString() && newData.child('name').val().length <= 200 && newData.child('pdf').isString() && root.child('meta/project').isString() && newData.child('_project').val() == root.child('meta/project').val() && newData.child('_by').val() == auth.token.email"
      }
    },

    // 🚚 To send (core/tosend.js): what the site needs from the shop, until the shop marks it
    // sent. Editors (foremen, PM) add and remove any; staff add (Shop page) and change or remove
    // only their own. Only the SHOP marks it sent or undoes that (Leo 10-19): accounts with the
    // custom claim shop = true (Actions → Project database, member, role shop) — on every
    // project, company email or not. They also read the list. Not the GC.
    "toSend": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists() || auth.token.shop == true)",
      "$id": {
        ".write": "auth != null && auth.token.email_verified == true && (root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || (auth.token.email.matches(/@advfacade\\.com$/i) && (!data.exists() || data.child('by').val() == auth.token.email)))",
        ".validate": "newData.hasChildren(['what', 'by', 'at', '_project']) && root.child('meta/project').isString() && newData.child('_project').val() == root.child('meta/project').val() && (data.exists() || newData.child('by').val() == auth.token.email) && (auth.token.shop == true || data.child('sent').exists() == newData.child('sent').exists())",
        "what": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "by": { ".validate": "newData.isString()" },
        "at": { ".validate": "newData.isNumber()" },
        "_project": { ".validate": "newData.isString()" },
        "qty": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 99999" },
        "need": { ".validate": "newData.isString() && newData.val().matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/)" },
        "note": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "photo": { ".validate": "newData.isString() && newData.val().length <= 1500 && (newData.val().beginsWith('https://') || newData.val().beginsWith('http://'))" },
        "sent": {
          ".write": "auth != null && auth.token.email_verified == true && auth.token.shop == true",
          ".validate": "newData.hasChildren(['by', 'at']) && newData.child('by').val() == auth.token.email",
          "by": { ".validate": "newData.isString()" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    // Warehouse (receive).
    "warehouse": {
      ".read": "auth != null && auth.token.email_verified == true && (auth.token.email.matches(/@advfacade\\.com$/i) || root.child('allowlist').child(auth.token.email.replace('.', ',')).exists() || root.child('gcList').child(auth.token.email.replace('.', ',')).exists() || root.child('viewers').child(auth.token.email.replace('.', ',')).exists())",
      "items": {
        ".indexOn": ["receivedAt"],
        "$itemId": {
          ".write": "auth != null && auth.token.email_verified == true && root.child('allowlist').child(auth.token.email.replace('.', ',')).exists()",
          ".validate": "newData.hasChildren(['where', 'receivedAt', 'receivedBy', 'status']) && newData.child('status').val() == 'in_stock'"
        }
      }
    },

    // Membership lists. Each person can read only their own entry; the lists
    // themselves are edited in the Firebase console (or by the admin workflow).
    "allowlist": {
      ".read": false, ".write": false,
      "$emailKey": { ".read": "auth != null && auth.token.email_verified == true && auth.token.email.replace('.', ',') == $emailKey" }
    },
    "gcList": {
      ".read": false, ".write": false,
      "$emailKey": { ".read": "auth != null && auth.token.email_verified == true && auth.token.email.replace('.', ',') == $emailKey" }
    },
    "viewers": {
      ".read": false, ".write": false,
      "$emailKey": { ".read": "auth != null && auth.token.email_verified == true && auth.token.email.replace('.', ',') == $emailKey" }
    }
  }
}
